# ==============================================================================
# STRATEGY ARENA COPY-TRADE ENGINE CONFIGURATION
# Copy-trade otomatis strategi "ROC Momentum 12", "EMA Deviation" & "Gap Fill Reversal" ke Akun Real MT5 ($1,000)
# ==============================================================================

# --- Kredensial Akun MetaTrader 5 ---
MT5_LOGIN=17607969
MT5_PASSWORD=MASUKKAN_PASSWORD_DISINI
MT5_SERVER=Headway-Real
MT5_IP_SERVER=mt5.real.trade-hw.online:443

# --- Sumber Sinyal Strategy Arena ---
# Gunakan http://172.17.0.1:8080 saat bot berjalan di dalam Docker
# Atau gunakan domain public: https://sa.chost.my.id
ARENA_BASE_URL=http://172.17.0.1:8080
ARENA_WS_URL=ws://172.17.0.1:8080/ws/signals
ARENA_API_KEY=pk_live_strategyarena_public_feed

# --- Strategi Target yang Disalin ---
# Multi-strategi: pisahkan ID dengan koma (contoh: roc_momentum,price_ema_dev,gap_fill)
TARGET_STRATEGIES=roc_momentum,price_ema_dev,gap_fill
TARGET_STRATEGY=roc_momentum,price_ema_dev,gap_fill
TARGET_STRATEGY_NAME="ROC Momentum 12, EMA Deviation & Gap Fill Reversal"
TARGET_MODE=forex
AUTO_SYNC_PAST_TRADES=true    # Sinkronkan posisi terbuka dari strategi terpilih secara otomatis
ALLOW_HEDGING=true            # Izinkan strategi berbeda membuka posisi berlawanan di pair yang sama (true/false)

# --- Manajemen Resiko & Ukuran Lot (Modal $1,000 USD) ---
# LOT_SIZING_MODE:
#   "PROPORTIONAL" -> Mengikuti lot sinyal strategi (1:1), dibatasi BASE_LOT (min) dan MAX_LOT (max)
#   "FIXED"        -> Selalu gunakan BASE_LOT (0.01 lot) secara kaku tanpa melihat lot strategi
#   "EQUITY_SCALE" -> Skala lot sinyal proporsional relatif thd equity akun / $1,000
LOT_SIZING_MODE=PROPORTIONAL
BASE_LOT=0.01
MAX_LOT=0.05
MAX_OPEN_POSITIONS=3

# --- Proteksi Modal & Circuit Breakers ---
MAX_DAILY_LOSS_USD=50.0        # Batas rugi harian maksimum ($50 = 5% dari modal $1,000)
MIN_EQUITY_USD=0               # Stop darurat jika equity habis menyentuh 0 (trading sampai saldo habis)
ENFORCE_SL=true                # Wajib pasang hard Stop Loss di server MT5
DEFAULT_SL_PIPS=35.0           # Fallback SL (pips) jika sinyal tidak menyertakan SL
DEFAULT_TP_PIPS=70.0           # Fallback TP (pips)

# --- Identifikasi Order di MT5 ---
MT5_MAGIC_NUMBER=889901
MT5_ORDER_COMMENT=SA:copytrade

# --- Koneksi Internal MT5 Container ---
MT5_HOST=sa-copytrade-mt5
MT5_PORT=18812
MT5_WEB_PORT=3002
MT5_VNC_PORT=5902

# --- Notifikasi Telegram (Opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pengaturan Bot ---
POLL_INTERVAL_SEC=10           # Interval sinkronisasi audit posisi berkala
LOG_LEVEL=INFO

