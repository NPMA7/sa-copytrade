# ==============================================================================
# STRATEGY ARENA COPY-TRADE ENGINE CONFIGURATION
# Copy-trade otomatis strategi "Gap Fill Reversal" ke Akun Real Headway MT5 ($1,000)
# ==============================================================================

# --- Kredensial Akun MetaTrader 5 (Headway Real) ---
MT5_LOGIN=17607969
MT5_PASSWORD=MASUKKAN_PASSWORD_DISINI
MT5_SERVER=Headway-Real
MT5_IP_SERVER=mt5.real.trade-hw.online:443

# --- Sumber Sinyal Strategy Arena ---
# Gunakan http://172.17.0.1:8080 saat bot berjalan di dalam Docker
# Atau gunakan domain public: https://sa.chost.my.id
ARENA_BASE_URL=http://172.17.0.1:8080
ARENA_WS_URL=ws://172.17.0.1:8080/ws/signals
ARENA_API_KEY=pk_live_strategyarena_public_feed

# --- Strategi Target yang Disalin ---
TARGET_STRATEGY=gap_fill
TARGET_STRATEGY_NAME="Gap Fill Reversal"
TARGET_MODE=forex

# --- Manajemen Resiko & Ukuran Lot (Modal $1,000 USD) ---
# LOT_SIZING_MODE:
#   "FIXED"        -> Selalu gunakan BASE_LOT (0.01 lot) - Paling aman untuk $1k
#   "PROPORTIONAL" -> Skala lot mengikuti equity relatif thd $1,000
LOT_SIZING_MODE=FIXED
BASE_LOT=0.01
MAX_LOT=0.05
MAX_OPEN_POSITIONS=3

# --- Proteksi Modal & Circuit Breakers ---
MAX_DAILY_LOSS_USD=50.0        # Batas rugi harian maksimum ($50 = 5% dari modal $1,000)
MIN_EQUITY_USD=800.0           # Stop darurat jika equity akun menyentuh $800
ENFORCE_SL=true                # Wajib pasang hard Stop Loss di server MT5
DEFAULT_SL_PIPS=35.0           # Fallback SL (pips) jika sinyal tidak menyertakan SL
DEFAULT_TP_PIPS=70.0           # Fallback TP (pips)

# --- Identifikasi Order di MT5 ---
MT5_MAGIC_NUMBER=889901
MT5_ORDER_COMMENT=SA:gap_fill

# --- Koneksi Internal MT5 Container ---
MT5_HOST=sa-copytrade-mt5
MT5_PORT=18812
MT5_WEB_PORT=3002
MT5_VNC_PORT=5902

# --- Notifikasi Telegram (Opsional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pengaturan Bot ---
POLL_INTERVAL_SEC=10           # Interval sinkronisasi audit posisi berkala
LOG_LEVEL=INFO
